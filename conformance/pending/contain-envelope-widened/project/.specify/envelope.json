{
  "id": "bugfix",
  "initial": "planning",
  "phases": {
    "planning": {
      "allowed_tools": [
        "Read",
        "Grep"
      ],
      "transitions": [
        {
          "to": "implement",
          "when": "test-result == 'fail'"
        }
      ]
    },
    "implement": {
      "allowed_tools": [
        "Read",
        "Edit",
        "Bash"
      ],
      "transitions": [
        {
          "to": "planning",
          "when": "test-result == 'pass'"
        }
      ],
      "fork": [
        "review",
        "document"
      ]
    }
  }
}

{
  "schema_version": "1.0",
  "id": "bugfix",
  "initial": "planning",
  "phases": {
    "planning": {
      "allowed_tools": [
        "Read",
        "Grep"
      ],
      "transitions": [
        {
          "to": "implement",
          "when": "coverage > 80"
        }
      ]
    },
    "implement": {
      "allowed_tools": [
        "Read",
        "Edit"
      ],
      "transitions": [
        {
          "to": "planning",
          "when": "test-result == 'pass'"
        }
      ]
    }
  }
}

# Normalize to LF in the repository. Kept after the Python removal even though the POSIX launcher
# scripts that originally motivated it are gone: Spec Kit vendors its own shell and PowerShell
# scripts under .specify/, and conformance fixtures are compared byte for byte.
* text=auto eol=lf

*.rs    text eol=lf
*.toml  text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.json  text eol=lf
*.dag   text eol=lf

# Conformance fixtures are inputs to a byte-comparing test. One of them is deliberately not valid
# UTF-8, and none of them may be rewritten by a checkout.
conformance/cases/**  -text

*.whl    binary
*.tar.gz binary
*.png    binary

#!/usr/bin/env dagger
#
# The Linux leg of CI, defined once and run identically from a laptop and from GitHub Actions:
#
#   dagger -M ci/rust.dag
#
# Deliberately SDK-less. Dagger's Rust SDK says of itself "do not use it for anything
# mission-critical", and it is a client SDK that cannot author modules anyway. Adopting the Go or
# TypeScript SDK would add a second language toolchain and a committed generated client to a
# repository that is in the middle of removing its only other language. Dagger Shell needs neither.
#
# SCOPE. Linux only, and that is a hard limit rather than a choice: Dagger runs Linux containers and
# nothing else, GitHub's macOS runners cannot run Docker at all, and its Windows runners cannot run
# Linux containers. The platform-sensitive behaviour this project exists to get right -- path
# separators, line endings, filesystem case sensitivity -- is verified natively on Windows and macOS
# in .github/workflows/ci.yml. Cross-compiling here would produce artifacts for those platforms
# while proving nothing about how the tool behaves on them.
#
# Three invocation details, each established by trying it rather than by reading docs:
#   * A script runs its TRAILING CALL. Passing a function name as an argument makes Dagger look for
#     a file by that name, so there is one entry point per file.
#   * `with-exec` parses leading dashes as its own flags, so every command needs `with-exec --`.
#   * A failing stage exits non-zero, so this is safe to use as a gate.
#   * Bare names like `test` and `build` are resolved by Dagger before user functions -- calling a
#     function named `test` makes it try to load a MODULE called "test" and fail. Hence the prefix.

RUST_IMAGE=rust:1-bookworm

# --gitignore keeps target/, review/ and the caches out of the upload. Without it the source
# transfer alone took 35 seconds locally, and a populated target/ would dwarf the rest.
# Dagger's default filter already drops .git, so nothing here may depend on git metadata; the
# mode-bit and line-ending checks that need it run outside the container, in the workflow.
src() {
  container |
    from $RUST_IMAGE |
    with-mounted-cache /usr/local/cargo/registry cargo-registry |
    with-directory /src . --gitignore |
    with-workdir /src
}

# A separate target cache per stage. Sharing one makes the stages serialize on cargo's build lock,
# which removes the concurrency that motivated splitting them.
# rust:1-bookworm ships neither rustfmt nor clippy, so each stage installs the component it needs.
check_fmt() {
  src |
    with-mounted-cache /src/target cargo-target-fmt |
    with-exec -- rustup component add rustfmt |
    with-exec -- cargo fmt --all --check |
    stdout
}

check_lint() {
  src |
    with-mounted-cache /src/target cargo-target-clippy |
    with-exec -- rustup component add clippy |
    with-exec -- cargo clippy --all-targets -- -D warnings |
    stdout
}

# The prebuilt nextest binary rather than `cargo install`, which would compile it from source on
# every cache miss for no benefit.
check_test() {
  src |
    with-mounted-cache /src/target cargo-target-test |
    with-exec -- sh -c "curl -LsSf https://get.nexte.st/latest/linux | tar zxf - -C /usr/local/cargo/bin" |
    with-exec -- cargo nextest run --all-targets |
    stdout
}

check_build() {
  src |
    with-mounted-cache /src/target cargo-target-release |
    with-exec -- cargo build --release |
    stdout
}

# This repository is the policy layer's own first consumer. Running its gate against its own
# specifications is what stops the gate rotting unnoticed -- which is exactly what had happened.
check_dogfood() {
  src |
    with-mounted-cache /src/target cargo-target-release |
    with-exec -- cargo run --release -- validate --project . --phase spec --all |
    stdout
}

check_fmt
check_lint
check_test
check_build
check_dogfood
